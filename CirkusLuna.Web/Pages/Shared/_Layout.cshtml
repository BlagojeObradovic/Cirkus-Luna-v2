<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cirkus Luna</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/circus.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">Cirkus Luna</a>
            <ul class="navbar-nav flex-row flex-wrap gap-2">
                <li class="nav-item"><a class="nav-link px-2" asp-page="/Index">Forside</a></li>
                <li class="nav-item"><a class="nav-link px-2" asp-page="/TourPlan/Index">Turneplan</a></li>
                <li class="nav-item"><a class="nav-link px-2" asp-page="/Performances/Index">Forestillinger</a></li>
                <li class="nav-item"><a class="nav-link px-2" asp-page="/Reservations/Index">Reservationer</a></li>
                <li class="nav-item"><a class="nav-link px-2" asp-page="/News/Index">Nyheder</a></li>
                <li class="nav-item"><a class="nav-link px-2" asp-page="/Customers/Index">Kunder</a></li>
                <li class="nav-item"><a class="nav-link px-2" asp-page="/Artists/Index">Artister</a></li>
                <li class="nav-item"><a class="nav-link px-2" asp-page="/Employees/Index">Medarbejdere</a></li>
                <li class="nav-item"><a class="nav-link px-2" asp-page="/TicketTypes/Index">Billettyper</a></li>
            </ul>
        </div>
    </nav>

    <main class="container pb-4">
        @RenderBody()
    </main>

    <footer class="border-top py-3 mt-4">
        <div class="container text-center text-muted small">
            <span>&copy; @DateTime.Now.Year Cirkus Luna</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
