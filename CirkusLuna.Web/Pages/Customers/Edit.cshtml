@page "{id:int}"
@model CirkusLuna.Web.Pages.Customers.EditModel
@{
    ViewData["Title"] = "Rediger Kunde";
}

<div class="page-header">
    <div class="container-xl">
        <h1><i class="bi bi-pencil me-2"></i>Rediger Kunde</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Index">Forside</a></li>
                <li class="breadcrumb-item"><a asp-page="Index">Kunder</a></li>
                <li class="breadcrumb-item active">Rediger</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xl pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="circus-card card">
                <div class="card-header"><i class="bi bi-person me-2"></i>Rediger Kundeoplysninger</div>
                <div class="card-body p-4">
                    <form method="post" class="circus-form">
                        <input type="hidden" asp-for="Customer.Id" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Customer.FirstName" class="form-label">Fornavn *</label>
                                <input asp-for="Customer.FirstName" class="form-control" />
                                <span asp-validation-for="Customer.FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Customer.LastName" class="form-label">Efternavn *</label>
                                <input asp-for="Customer.LastName" class="form-control" />
                                <span asp-validation-for="Customer.LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Customer.Email" class="form-label">Email *</label>
                                <input asp-for="Customer.Email" class="form-control" />
                                <span asp-validation-for="Customer.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Customer.Phone" class="form-label">Telefon</label>
                                <input asp-for="Customer.Phone" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Customer.Address" class="form-label">Adresse</label>
                                <input asp-for="Customer.Address" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Customer.City" class="form-label">By</label>
                                <input asp-for="Customer.City" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Customer.PostalCode" class="form-label">Postnummer</label>
                                <input asp-for="Customer.PostalCode" class="form-control" />
                            </div>
                        </div>
                        <hr class="circus-divider" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-circus-primary">
                                <i class="bi bi-check-circle me-1"></i>Gem ændringer
                            </button>
                            <a asp-page="Index" class="btn btn-outline-secondary">Annuller</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
