@page
@model CirkusLuna.Web.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Kunder";
}

<div class="page-header">
    <div class="container-xl">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="bi bi-people me-2"></i>Kunder</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-page="/Index">Forside</a></li>
                        <li class="breadcrumb-item active">Kunder</li>
                    </ol>
                </nav>
            </div>
            <a asp-page="Create" class="btn btn-circus-gold">
                <i class="bi bi-plus-circle me-1"></i>Ny Kunde
            </a>
        </div>
    </div>
</div>

<div class="container-xl pb-5">
    <!-- Search -->
    <div class="row mb-4">
        <div class="col-md-6">
            <form method="get" class="circus-search">
                <i class="bi bi-search search-icon"></i>
                <input type="text" name="query" value="@Model.Query" class="form-control" placeholder="Søg efter navn, email eller by…" />
            </form>
        </div>
        @if (!string.IsNullOrEmpty(Model.Query))
        {
            <div class="col-md-6 d-flex align-items-center">
                <span class="text-muted">@Model.Customers.Count resultat(er) for "@Model.Query"</span>
                <a asp-page="Index" class="btn btn-sm btn-outline-secondary ms-2">Ryd søgning</a>
            </div>
        }
    </div>

    @if (Model.Customers.Any())
    {
        <div class="table-responsive">
            <table class="table circus-table">
                <thead>
                    <tr>
                        <th>Navn</th>
                        <th>Email</th>
                        <th>Telefon</th>
                        <th>By</th>
                        <th>Oprettet</th>
                        <th>Handlinger</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Customers.Count; i++)
                    {
                        var c = Model.Customers[i];
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                         style="width:36px;height:36px;background:linear-gradient(135deg,var(--circus-red),var(--circus-deep-red));font-size:0.85rem;flex-shrink:0;">
                                        @c.FirstName[0]@c.LastName[0]
                                    </div>
                                    <strong>@c.FullName</strong>
                                </div>
                            </td>
                            <td><a href="mailto:@c.Email">@c.Email</a></td>
                            <td>@c.Phone</td>
                            <td>@c.City</td>
                            <td class="small text-muted">@c.CreatedDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-circus-outline">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-page="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">👤</div>
            <h5>Ingen kunder fundet</h5>
            <p class="text-muted">@(string.IsNullOrEmpty(Model.Query) ? "Der er endnu ikke oprettet nogen kunder." : "Ingen kunder matcher din søgning.")</p>
            <a asp-page="Create" class="btn btn-circus-primary">Opret første kunde</a>
        </div>
    }
</div>
