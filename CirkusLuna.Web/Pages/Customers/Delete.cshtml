@page "{id:int}"
@model CirkusLuna.Web.Pages.Customers.DeleteModel
@{
    ViewData["Title"] = "Slet Kunde";
}

<div class="page-header">
    <div class="container-xl">
        <h1><i class="bi bi-trash me-2"></i>Slet Kunde</h1>
    </div>
</div>

<div class="container-xl pb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="circus-card card border-danger">
                <div class="card-header" style="background: linear-gradient(135deg,#922B21,#C0392B);">
                    <i class="bi bi-exclamation-triangle me-2"></i>Bekræft sletning
                </div>
                <div class="card-body p-4 text-center">
                    <p class="fs-5">Er du sikker på, at du vil slette kunden</p>
                    <h4 class="gold-text">@Model.CustomerName</h4>
                    <p class="text-muted">Denne handling kan ikke fortrydes.</p>
                    <form method="post" class="d-flex gap-2 justify-content-center mt-4">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Slet permanent
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Annuller</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
