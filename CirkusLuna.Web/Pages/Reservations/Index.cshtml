@page
@model CirkusLuna.Web.Pages.Reservations.IndexModel
@{
    ViewData["Title"] = "Reservationer";
}

<div class="page-header">
    <div class="container-xl">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="bi bi-ticket me-2"></i>Reservationer</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-page="/Index">Forside</a></li>
                        <li class="breadcrumb-item active">Reservationer</li>
                    </ol>
                </nav>
            </div>
            <a asp-page="Create" class="btn btn-circus-gold"><i class="bi bi-plus-circle me-1"></i>Ny Reservation</a>
        </div>
    </div>
</div>

<div class="container-xl pb-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-circus alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-circus alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-5">
            <form method="get" class="circus-search">
                <i class="bi bi-search search-icon"></i>
                <input type="text" name="query" value="@Model.Query" class="form-control" placeholder="Søg efter kunde eller by…" />
            </form>
        </div>
    </div>

    @if (Model.Reservations.Any())
    {
        <div class="table-responsive">
            <table class="table circus-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Kunde</th>
                        <th>Forestilling</th>
                        <th>Billetter</th>
                        <th>Type</th>
                        <th>Totalpris</th>
                        <th>Dato</th>
                        <th>Handlinger</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Reservations.Count; i++)
                    {
                        var r = Model.Reservations[i];
                        <tr>
                            <td class="text-muted small">@r.Id</td>
                            <td>
                                <strong>@(r.Customer?.FullName ?? "–")</strong><br/>
                                <span class="small text-muted">@r.Customer?.Email</span>
                            </td>
                            <td>
                                @if (r.Performance != null)
                                {
                                    <span><i class="bi bi-geo-alt-fill text-danger me-1"></i>@r.Performance.City?.Name</span><br/>
                                    <span class="small text-muted">@r.Performance.DateDisplay @r.Performance.TimeDisplay</span>
                                }
                            </td>
                            <td class="text-center"><strong>@r.NumberOfTickets</strong></td>
                            <td>
                                @if (r.TicketCategory == CirkusLuna.ClassLibrary.Models.TicketCategory.VIP)
                                {
                                    <span class="badge-circus-vip">VIP</span>
                                }
                                else if (r.TicketCategory == CirkusLuna.ClassLibrary.Models.TicketCategory.Children)
                                {
                                    <span class="badge-circus-children">Børn</span>
                                }
                                else
                                {
                                    <span class="badge-circus-regular">Alm.</span>
                                }
                            </td>
                            <td><strong>@r.TotalPrice.ToString("N0") kr</strong></td>
                            <td class="small text-muted">@r.ReservationDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <a asp-page="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🎟️</div>
            <h5>Ingen reservationer fundet</h5>
            <a asp-page="Create" class="btn btn-circus-primary">Opret første reservation</a>
        </div>
    }
</div>
