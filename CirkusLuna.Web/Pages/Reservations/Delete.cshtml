@page "{id:int}"
@model CirkusLuna.Web.Pages.Reservations.DeleteModel
@{ ViewData["Title"] = "Annuller Reservation"; }

<div class="page-header"><div class="container-xl"><h1><i class="bi bi-x-circle me-2"></i>Annuller Reservation</h1></div></div>
<div class="container-xl pb-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="circus-card card">
                <div class="card-header" style="background:linear-gradient(135deg,#922B21,#C0392B);"><i class="bi bi-exclamation-triangle me-2"></i>Bekræft annullering</div>
                <div class="card-body p-4 text-center">
                    <p>Er du sikker på, at du vil annullere reservation <strong>#@Model.ReservationId</strong>?</p>
                    <p class="text-muted small">Dette vil frigive de reserverede pladser.</p>
                    <form method="post" class="d-flex gap-2 justify-content-center">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-1"></i>Annuller reservation</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Behold reservation</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
