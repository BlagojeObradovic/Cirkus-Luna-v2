@page
@model CirkusLuna.Web.Pages.Seats.IndexModel
@{
    ViewData["Title"] = "Siddepladseoversigt";
}

<div class="page-header">
    <div class="container-xl">
        <h1><i class="bi bi-grid-3x3 me-2"></i>Siddepladseoversigt</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Index">Forside</a></li>
                <li class="breadcrumb-item active">Pladsoversigt</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xl pb-5">
    <!-- Performance selector -->
    <div class="circus-card card mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label small fw-bold">Vælg forestilling</label>
                    <select name="performanceId" class="form-select" onchange="this.form.submit()">
                        <option value="">– Vælg en forestilling –</option>
                        @foreach (var p in Model.AllPerformances)
                        {
                            <option value="@p.Id" selected="@(Model.SelectedPerformanceId == p.Id)">
                                @p.City?.Name – @p.DateDisplay kl. @p.TimeDisplay
                            </option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Performance != null)
    {
        var p = Model.Performance;

        <div class="row g-4">
            <div class="col-lg-9">
                <div class="seat-map-container">
                    <div class="circus-ring">🎪 MANEGEN 🎪</div>

                    <!-- VIP Row -->
                    <div class="mb-4">
                        <div class="text-center mb-2">
                            <span class="badge-circus-vip">👑 VIP-rækken</span>
                        </div>
                        <div class="d-flex justify-content-center align-items-center gap-1 flex-wrap">
                            <span class="seat-row-label" style="color:var(--circus-gold);">VIP</span>
                            @for (int i = 0; i < p.Seats.Count; i++)
                            {
                                var seat = p.Seats[i];
                                if (!seat.IsVip) break;

                                string seatClass = seat.Status == CirkusLuna.ClassLibrary.Models.SeatStatus.Available
                                    ? "vip-available" : "vip-reserved";
                                <div class="seat @seatClass" title="VIP Plads @seat.SeatNumber – @(seat.Status == CirkusLuna.ClassLibrary.Models.SeatStatus.Available ? "Ledig" : "Reserveret")">
                                    @seat.SeatNumber
                                </div>
                            }
                        </div>
                    </div>

                    <hr style="border-color:rgba(255,255,255,0.1);margin:1rem 0;" />

                    <!-- Regular Rows -->
                    @{
                        var regularSeats = new List<CirkusLuna.ClassLibrary.Models.Seat>();
                        for (int si = 0; si < p.Seats.Count; si++)
                        {
                            if (!p.Seats[si].IsVip)
                                regularSeats.Add(p.Seats[si]);
                        }
                        int currentRow = -1;
                    }

                    @for (int i = 0; i < regularSeats.Count; i++)
                    {
                        var seat = regularSeats[i];

                        if (seat.Row != currentRow)
                        {
                            if (currentRow != -1)
                            {
                                @:</div>
                            }
                            currentRow = seat.Row;
                            @:<div class="d-flex justify-content-center align-items-center gap-1 mb-1">
                            @:<span class="seat-row-label">@currentRow</span>
                        }

                        string seatClass2 = seat.Status == CirkusLuna.ClassLibrary.Models.SeatStatus.Available
                            ? "available" : "reserved";
                        <div class="seat @seatClass2" title="Plads @seat.SeatNumber (Række @seat.Row, Sæde @seat.SeatInRow) – @(seat.Status == CirkusLuna.ClassLibrary.Models.SeatStatus.Available ? "Ledig" : "Reserveret")">
                            @seat.SeatInRow
                        </div>
                    }
                    @if (currentRow != -1)
                    {
                        @:</div>
                    }

                    <!-- Legend -->
                    <div class="seat-legend">
                        <div class="seat-legend-item">
                            <div class="seat-legend-box" style="background:#e9ecef;border:1px solid #ced4da;border-radius:4px 4px 0 0;"></div>
                            <span>Ledig</span>
                        </div>
                        <div class="seat-legend-item">
                            <div class="seat-legend-box" style="background:#E74C3C;border-radius:4px 4px 0 0;"></div>
                            <span>Reserveret</span>
                        </div>
                        <div class="seat-legend-item">
                            <div class="seat-legend-box" style="background:var(--circus-gold);border-radius:4px 4px 0 0;"></div>
                            <span>VIP Ledig</span>
                        </div>
                        <div class="seat-legend-item">
                            <div class="seat-legend-box" style="background:#8B6914;border-radius:4px 4px 0 0;"></div>
                            <span>VIP Reserveret</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-3">
                <div class="circus-card card mb-3">
                    <div class="card-header gold"><i class="bi bi-info-circle me-2"></i>Forestillingsinfo</div>
                    <div class="card-body p-3 small">
                        <div><i class="bi bi-geo-alt-fill text-danger me-1"></i><strong>@p.City?.Name</strong></div>
                        <div class="text-muted">@p.City?.Venue</div>
                        <hr style="border-color:#E8D5B7;" />
                        <div><i class="bi bi-calendar3 me-1"></i>@p.DateDisplay</div>
                        <div><i class="bi bi-clock me-1"></i>@p.TimeDisplay</div>
                    </div>
                </div>

                <div class="circus-card card mb-3">
                    <div class="card-header"><i class="bi bi-speedometer me-2"></i>Kapacitet</div>
                    <div class="card-body p-3">
                        <div class="text-center mb-2">
                            <div class="stat-number" style="font-size:2rem;">@p.AvailableRegularSeats</div>
                            <div class="stat-label">alm. pladser ledige</div>
                        </div>
                        <div class="text-center">
                            <div class="stat-number" style="font-size:2rem;color:#8B6914;">@p.AvailableVipSeats</div>
                            <div class="stat-label">VIP-pladser ledige</div>
                        </div>
                    </div>
                </div>

                @if (p.IsFuture)
                {
                    <a asp-page="/Reservations/Create" asp-route-performanceId="@p.Id" class="btn btn-circus-gold w-100">
                        <i class="bi bi-ticket-perforated me-2"></i>Reservér Billet
                    </a>
                }
            </div>
        </div>
    }
    else if (Model.SelectedPerformanceId.HasValue)
    {
        <div class="alert alert-danger alert-circus">Forestillingen blev ikke fundet.</div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🎪</div>
            <p>Vælg en forestilling ovenfor for at se pladsoversigten.</p>
        </div>
    }
</div>
